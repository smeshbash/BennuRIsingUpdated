{
  "name": "bennu-rising-international",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --external:express --external:cors --external:dotenv --external:razorpay --external:@supabase/supabase-js --external:resend --external:vite --sourcemap --outfile=dist/server.cjs && mkdir -p dist/data && cp node_modules/pdfkit/js/data/*.afm node_modules/pdfkit/js/data/*.icc dist/data/",
    "preview": "vite preview",
    "lint": "tsc --noEmit",
    "start": "node dist/server.cjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.84.0",
    "@types/dompurify": "^3.0.5",
    "cors": "^2.8.6",
    "dompurify": "^3.3.3",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "lucide-react": "^0.554.0",
    "motion": "^12.40.0",
    "pdfkit": "^0.19.1",
    "razorpay": "^2.9.8",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-helmet-async": "^2.0.5",
    "react-router-dom": "^7.9.6",
    "resend": "^6.20.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.14.0",
    "@types/pdfkit": "^0.17.6",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.0.0",
    "esbuild": "^0.28.1",
    "tsx": "^4.23.11",
    "typescript": "~5.8.2",
    "vite": "^8.2.1"
  }
}
