RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
VITE_RAZORPAY_KEY_ID=

# From Razorpay Dashboard > Settings > Webhooks, when you create the webhook.
# This secret is what lets /api/webhooks/razorpay verify a request genuinely
# came from Razorpay (never share it, never send it to the frontend).
RAZORPAY_WEBHOOK_SECRET=

# Backend-only Supabase credentials for the webhook handler. SUPABASE_SERVICE_ROLE_KEY
# bypasses Row Level Security, so it must NEVER be prefixed with VITE_ (that would
# bundle it into the frontend build and expose it to every visitor).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Frontend Supabase config (safe to expose — anon key is public by design)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional — donation receipt emails. If RESEND_API_KEY is unset, the webhook
# simply skips sending a receipt (donations still record fine either way).
# Get a key from https://resend.com after verifying your sending domain.
RESEND_API_KEY=
# Must be an address on a domain you've verified in Resend. Falls back to
# Resend's own onboarding@resend.dev sandbox address if left unset (fine for
# testing, but that address can only send to your own Resend account email
# until a domain is verified).
RECEIPT_FROM_EMAIL=
